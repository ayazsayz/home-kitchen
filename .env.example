# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Card payments (optional) ----------
# Leave PAYMENT_PROVIDER empty to offer cash only. Otherwise: ziina or stripe.
# Then turn on "Let customers pay by card" in /admin/settings.
PAYMENT_PROVIDER=
ZIINA_API_KEY=
# true = test payments, nothing is charged. Set to false to take real payments.
ZIINA_TEST_MODE=true
# sk_test_... or sk_live_...
STRIPE_SECRET_KEY=

# ---------- Map pin (optional) ----------
# Leave empty to use OpenStreetMap (free, no key). Set a Google Maps JavaScript API key
# (restricted to your site's domain) to use Google Maps in the checkout picker instead.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------- Daily summary email (optional) ----------
# Free account at https://resend.com → API Keys. Set the address to send to in /admin/settings.
RESEND_API_KEY=
# Sender, e.g. "My Kitchen <reports@yourdomain.com>" (needs a verified domain in Resend).
# Leave empty to use Resend's test sender, which can only email your own Resend account address.
SUMMARY_FROM=
# Any long random string. Vercel uses it to call the nightly summary job securely.
CRON_SECRET=
